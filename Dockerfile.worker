# VideoFetch Worker runtime image (Phase 8A).
#
# This image builds the STANDALONE Worker only. The web/control plane runs on
# Vercel and keeps its own `Dockerfile`; nothing here builds, serves or previews
# the web application.
#
# Since PHASE-10C1-YTDLP-RUNTIME-FOUNDATION-001 this image DOES ship a pinned
# yt-dlp runtime plus the Python interpreter it needs. That is a runtime
# foundation and nothing more:
#
#   installing the yt-dlp runtime  !=  enabling generic yt-dlp execution
#
# No user-supplied URL is executable by yt-dlp in this image. The only yt-dlp
# operation any Production Worker code performs is a non-network version probe
# (src/worker/runtime/ytdlp-runtime.server.ts). Generic user-URL execution is a
# later, separately authorized phase, gated by YTDLP_ENABLED, which is
# deliberately NOT set here.
#
# Deliberately NOT part of this image:
#   - pip / venv       : the yt-dlp artifact is a single pinned zipimport file
#                        fetched by exact digest at build time. Nothing in this
#                        image can install, upgrade or replace a Python package.
#   - curl / wget      : nothing inside this image probes over HTTP. Liveness is
#                        probed by the deployment layer from OUTSIDE the
#                        restricted media namespace.
#   - ssh / sudo       : no remote administration from inside the container.
#   - iptables/nftables: the safe-egress policy is an EXTERNAL, host-owned
#                        boundary. The Worker must never be able to read,
#                        weaken or mutate it, and must never hold NET_ADMIN.
#   - docker CLI       : the container never talks to a Docker socket.
FROM node:22-bookworm-slim

# ffmpeg brings ffprobe with it. ca-certificates provides the TLS trust roots
# used for outbound media fetches.
#
# python3 is Debian Bookworm's system interpreter (3.11). yt-dlp 2026.08.19
# refuses to import on Python < 3.10, so the base image satisfies it directly:
# no virtual environment, no pip, and no third-party Python package is
# installed anywhere in this build.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates python3 \
  && rm -rf /var/lib/apt/lists/*

# The pinned yt-dlp runtime.
#
# This is the official PLATFORM-INDEPENDENT UNIX ZIPIMPORT executable from an
# exact upstream release — a single ~3 MB file with a `#!/usr/bin/env python3`
# shebang and a zip payload. It is deliberately NOT `yt-dlp_linux_aarch64`: the
# PyInstaller builds unpack themselves into a temporary directory on every run,
# which this container's read-only root and `noexec` media tmpfs would break.
#
# `ADD --checksum` verifies the digest published in the release's own
# SHA2-256SUMS at BUILD time, so the build fails closed if the asset ever
# differs. It also needs no download tooling in the final image, which is what
# keeps curl and wget out.
#
# The URL is an immutable release URL. There is no `latest`, no nightly, no
# mirror, and no runtime `pip install`. Upgrading yt-dlp means changing this
# version and this digest — together, in a reviewed commit, alongside
# YTDLP_RUNTIME in src/worker/runtime/ytdlp-runtime.server.ts, which
# container-policy.test.ts asserts must agree with these exact values.
ADD --checksum=sha256:1fa6733c37ea6fb51c99ad8fe785e7b7e5f3246c9b980230329d4fb72ed8d4d6 \
    https://github.com/yt-dlp/yt-dlp/releases/download/2026.08.19/yt-dlp \
    /usr/local/lib/videofetch/yt-dlp

# Root-owned and read-only, on the read-only root filesystem. The Worker runs
# as `node` and therefore cannot rewrite, replace or self-update its own media
# runtime — the property that makes `--no-update` a statement of intent rather
# than the actual control.
RUN chown root:root /usr/local/lib/videofetch/yt-dlp \
  && chmod 0555 /usr/local/lib/videofetch/yt-dlp

WORKDIR /app

# Production dependency graph only. Installation is always `ci` — never
# `install` — so the committed lockfile is authoritative and the build is
# reproducible.
#
# The npm bundled with node:22 (10.9.x) rejects this repository's committed
# lockfile over a PRE-EXISTING devDependency resolution (nitro -> unstorage
# wants lru-cache@^11, the lock pins 5.1.1). npm 11 resolves the same lockfile
# cleanly, so an EXACT PINNED npm 11 is fetched ephemerally to run `ci` and is
# then discarded with the caches. Nothing is installed globally, and neither
# package.json nor package-lock.json is modified — the repository dependency
# graph is untouched, and none of the affected devDependencies ship here.
# Tracked separately as NPM-LOCKFILE-RECONCILIATION-001.
COPY package.json package-lock.json ./
RUN npx --yes npm@11.19.1 ci --omit=dev \
  && npm cache clean --force \
  && rm -rf /root/.npm/_npx /root/.npm/_cacache

# The Worker runs TypeScript directly through Node's native type stripping plus
# the repository's existing alias loader. No transpiler is added for this image.
COPY scripts/register-ts-aliases.mjs scripts/ts-alias-hooks.mjs ./scripts/
COPY src ./src

# The trusted R2 credential broker is NOT part of the media container.
#
# It runs on the VM host, as its own user, in its own systemd unit, outside
# this network namespace, and it is the sole holder of the persistent R2 parent
# credential. Its source is removed here so the media image contains no code
# that knows how to mint from a parent secret. This is defence in depth, not
# the boundary itself: the container is never given R2_BROKER_PARENT_* either,
# and the Worker runtime refuses to start if it is.
RUN rm -rf ./src/broker

# Two distinct filesystem roles, both owned by the non-root runtime UID:
#   /var/lib/videofetch  durable SQLite state. A persistent volume MUST be
#                        mounted here, and it holds the database plus its
#                        WAL/SHM sidecars only — never media.
#   /tmp/videofetch      ephemeral media working files. Never durable state.
# This layout is compatible with a read-only root filesystem plus a writable
# state mount and a writable ephemeral /tmp.
RUN mkdir -p /var/lib/videofetch /tmp/videofetch \
  && chown -R node:node /var/lib/videofetch /tmp/videofetch

# YTDLP_NETWORK_ISOLATED is deliberately ABSENT and must stay absent.
#
# It was a Phase-8/9 operator assertion, never a security boundary — the real
# boundary is the externally owned media network namespace and nftables policy,
# which this container can neither read nor alter. The Worker runtime now
# REFUSES TO START if the variable is present at all, even as `false`, so a
# stale deployment fails closed instead of silently carrying a retired
# contract. YTDLP_PATH is refused for the same reason.
#
# YTDLP_ENABLED is also deliberately absent: absent means disabled, and no
# image may enable generic yt-dlp execution by itself.
ENV NODE_ENV=production \
    WORKER_BIND_HOST=0.0.0.0 \
    WORKER_PORT=8080 \
    WORKER_DATA_DIRECTORY=/var/lib/videofetch \
    TEMP_DIRECTORY=/tmp/videofetch \
    FFMPEG_PATH=/usr/bin/ffmpeg

# No secret is baked into this image, and this container holds NO persistent R2
# credential at all (WORKER-R2-TEMP-CREDENTIAL-DELEGATION-001).
#
# WORKER_CONTROL_KEY_ID / WORKER_CONTROL_SECRET are supplied at RUNTIME from the
# deployment's secret store. Object storage is reached through the trusted host
# broker over a Unix socket bind-mounted at R2_BROKER_SOCKET_PATH, which yields
# a short-lived credential scoped to one action and one exact object key.
#
# Never provided to this container:
#   - R2_BROKER_PARENT_ACCESS_KEY_ID / R2_BROKER_PARENT_SECRET_ACCESS_KEY
#     (the parent credential; the broker's alone)
#   - R2_WRITER_*   (the superseded persistent writer contract)
#   - R2_SIGNER_*   (the Vercel-only read identity)
#
# The Worker runtime does not merely ignore those variables — it refuses to
# start if any of them is present, so a stale deployment fails closed instead of
# quietly reintroducing a long-lived credential into the media namespace.

# The Worker speaks plain HTTP. Phase-8B deployment MUST terminate TLS in front
# of it before traffic crosses the public internet. There is no second
# admin/debug port.
EXPOSE 8080

# Every process from here on runs as the image's non-root `node` user.
USER node

# There is deliberately NO HEALTHCHECK in this image.
#
# The accepted Phase-8B deployment runs the Worker inside a media network
# namespace whose externally-owned safe-egress policy DENIES loopback and
# private destinations outright, including the Worker's own listener address.
# Any in-container probe would therefore have to target a destination the
# security boundary exists to block, and the only ways to make such a probe
# succeed are to punch a hole in the egress policy or to weaken the deny set.
# Neither is acceptable: the boundary outranks the convenience of a built-in
# healthcheck.
#
# Liveness is unchanged at the application level — `GET /v1/healthz` remains the
# minimal unauthenticated endpoint — but the PROBE is owned by the deployment
# layer and runs from OUTSIDE the restricted namespace. See
# docs/architecture/worker-deployment-runbook.md ("Health and maintenance").

# The Worker runtime entry point. Not Vite, not Nitro, not `npm run preview`.
CMD ["node", "--import", "./scripts/register-ts-aliases.mjs", "--experimental-strip-types", "src/worker/runtime/main.server.ts"]
