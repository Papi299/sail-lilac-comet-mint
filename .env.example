# VideoFetch operator settings. None of these are required for local
# development. Do not prefix server secrets with VITE_ — they must not reach
# the browser bundle.

# Server-only private-access secret. Minimum 32 UTF-8 bytes.
# Production (NODE_ENV=production) requires this value; if it is missing, empty,
# or too short the downloader APIs fail closed with HTTP 503 ACCESS_NOT_CONFIGURED
# instead of becoming public. Rotating it invalidates active private-access sessions.
# Generate with: openssl rand -base64 32
VIDEOFETCH_ACCESS_SECRET=

NODE_ENV=development
MAX_FILE_SIZE=524288000
MAX_VIDEO_DURATION=7200
FILE_EXPIRATION_MINUTES=45
MAX_CONCURRENT_DOWNLOADS=3
MAX_CONCURRENT_PER_PRINCIPAL=2
RATE_LIMIT=20
TEMP_DIRECTORY=
YTDLP_NETWORK_ISOLATED=

# --- Worker control plane (server-only) ---------------------------------------
# Vercel signs every worker request with these. They are an environment CONTRACT
# only: no real values are set here, and none of them may ever be prefixed with
# VITE_. If any is missing or malformed the control plane fails closed at request
# time with WORKER_UNAVAILABLE and discloses nothing about the configuration.
WORKER_BASE_URL=
WORKER_CONTROL_KEY_ID=
WORKER_CONTROL_SECRET=

# --- Object-store GET signer (server-only) ------------------------------------
# Vercel signs short-lived GetObject URLs with this identity ONLY. These are not
# the worker's writer credentials and must never be granted Put/Head/Delete/List
# or bucket administration.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_JURISDICTION=
R2_SIGNER_ACCESS_KEY_ID=
R2_SIGNER_SECRET_ACCESS_KEY=
# Optional; only for temporary credentials.
R2_SIGNER_SESSION_TOKEN=
