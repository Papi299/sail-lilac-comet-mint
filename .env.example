# VideoFetch operator settings.
#
# This file is an environment CONTRACT: every value here is intentionally EMPTY.
# Never commit a real secret, account id, bucket name or hostname.
#
# The deployment has TWO separate runtimes with two separate identities:
#
#   [VERCEL]  the web/control plane. Owns user authentication, orchestration,
#             Worker request signing, and short-lived object-store GET signing.
#   [WORKER]  the long-lived standalone media runtime. Owns durable SQLite
#             state, media execution, and object-store WRITES.
#
# A variable belongs to exactly one runtime unless it is explicitly marked
# SHARED. Do not prefix any server secret with VITE_ — that would publish it to
# the browser bundle.


# ══════════════════════════════════════════════════════════════════════════════
# [VERCEL] Web / control plane
# ══════════════════════════════════════════════════════════════════════════════

# Server-only private-access secret. Minimum 32 UTF-8 bytes.
# Production (NODE_ENV=production) requires this value; if it is missing, empty,
# or too short the downloader APIs fail closed with HTTP 503 ACCESS_NOT_CONFIGURED
# instead of becoming public. Rotating it invalidates active private-access sessions.
# Generate with: openssl rand -base64 32
VIDEOFETCH_ACCESS_SECRET=

# Base URL of the deployed Worker. Vercel fails closed with WORKER_UNAVAILABLE
# when this is missing or the Worker cannot be reached; it NEVER falls back to
# running media processing locally.
WORKER_BASE_URL=

# --- [VERCEL] Cloudflare Access service token (server-only) -------------------
# OPTIONAL until Cloudflare Access is actually deployed in front of the Worker.
# Configure BOTH or NEITHER: exactly one of the pair makes getWorkerClient()
# fail closed with WORKER_UNAVAILABLE, without naming which half was wrong.
#
# These authenticate VERCEL to the Cloudflare Access layer that fronts the
# Worker tunnel. They are sent as the CF-Access-Client-Id / CF-Access-Client-Secret
# request headers and are INDEPENDENT of the VideoFetch HMAC credentials below:
# they are never part of the HMAC canonical request, and rotating them does not
# touch the shared Worker signing pair.
#
# The Worker NEVER receives these values, and the browser must never see them.
# Never prefix them with VITE_.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=

# --- [VERCEL] Object-store GET signer (server-only) ---------------------------
# Vercel's production code signs GetObject with this identity and nothing else.
# It is a SEPARATE credential from the Worker's writer identity, and the Worker
# must NEVER receive these values.
#
# Note the difference between the two boundaries. The APPLICATION boundary is
# exact: Vercel only ever signs GetObject. The PROVIDER boundary is coarser —
# R2's persistent S3 token presets are read+list or read+write+list, so the
# issued token may permit more than the application invokes. Exact per-action
# scoping needs temporary credentials, which is deliberately out of scope here.
# Tracked as R2-CREDENTIAL-SCOPE-DECISION-001 (BLOCKING before provisioning).
# Required regardless: separate identities, bucket-scoped, no bucket admin.
R2_SIGNER_ACCESS_KEY_ID=
R2_SIGNER_SECRET_ACCESS_KEY=
# Optional; only for temporary credentials.
R2_SIGNER_SESSION_TOKEN=


# ══════════════════════════════════════════════════════════════════════════════
# [WORKER] Standalone Worker runtime
# ══════════════════════════════════════════════════════════════════════════════
# Consumed exclusively by src/worker/runtime/config.server.ts. Malformed or
# missing REQUIRED values fail startup closed, before the Worker ever listens.

# --- [WORKER] Listener --------------------------------------------------------
# Internal bind only. Phase-8B deployment MUST terminate TLS in front of the
# Worker; it speaks plain HTTP and exposes no second admin/debug port.
# Defaults: 0.0.0.0 and 8080.
WORKER_BIND_HOST=
WORKER_PORT=

# --- [WORKER] Persistent state ------------------------------------------------
# REQUIRED. Absolute path to the persistent volume holding the Worker's SQLite
# database and its WAL/SHM sidecars — and nothing else. The database file name
# is derived internally; it is never configurable and never request-controlled.
# Must NOT be under /tmp. Container default: /var/lib/videofetch
WORKER_DATA_DIRECTORY=

# --- [SHARED] Worker HMAC control credentials ---------------------------------
# The SAME key id and secret are configured on BOTH Vercel (to sign) and the
# Worker (to verify). Minimum 32 UTF-8 bytes. Generate with:
#   openssl rand -base64 32
WORKER_CONTROL_KEY_ID=
WORKER_CONTROL_SECRET=

# Optional rotation slot, verified by the WORKER only. Supply BOTH or NEITHER;
# the previous key id must differ from the current one. During a rotation the
# Worker accepts both identities so in-flight Vercel requests keep working.
WORKER_CONTROL_PREVIOUS_KEY_ID=
WORKER_CONTROL_PREVIOUS_SECRET=

# --- [SHARED] Object-store location -------------------------------------------
# Location only, no credentials. Both runtimes address the same private bucket.
# R2_JURISDICTION is one of: default | eu | us  (defaults to "default").
R2_ACCOUNT_ID=
R2_BUCKET=
R2_JURISDICTION=

# --- [WORKER] Object-store WRITER credentials ---------------------------------
# The Worker's production code performs exactly PutObject, HeadObject and
# DeleteObject with this identity — its ObjectStoreWriter interface cannot
# express get, list, presign or bucket administration at all.
#
# As with the signer above, the PROVIDER-issued token may still be broader than
# that application surface, because R2's persistent S3 token presets are coarse.
# Do not assume this token lacks GetObject/ListObjects. See
# R2-CREDENTIAL-SCOPE-DECISION-001 in the deployment runbook.
# Required regardless: a DISTINCT identity from R2_SIGNER_*, bucket-scoped, and
# no bucket administration.
R2_WRITER_ACCESS_KEY_ID=
R2_WRITER_SECRET_ACCESS_KEY=
# Optional; only for temporary credentials.
R2_WRITER_SESSION_TOKEN=


# ══════════════════════════════════════════════════════════════════════════════
# [SHARED] Media execution limits
# ══════════════════════════════════════════════════════════════════════════════
# The Worker validates these strictly and fails startup closed on a malformed
# value rather than silently falling back to a default.

NODE_ENV=development
MAX_FILE_SIZE=524288000
MAX_VIDEO_DURATION=7200
FILE_EXPIRATION_MINUTES=45
MAX_CONCURRENT_DOWNLOADS=3
MAX_CONCURRENT_PER_PRINCIPAL=2
RATE_LIMIT=20

# Ephemeral media working directory. Absolute path. MUST be distinct from
# WORKER_DATA_DIRECTORY — media is never written to the durable SQLite volume.
# Container default: /tmp/videofetch
TEMP_DIRECTORY=

# Absolute path to the ffmpeg binary. Container default: /usr/bin/ffmpeg
FFMPEG_PATH=

# Operator attestation that yt-dlp runs behind an independently enforced
# safe-egress boundary. Default is fail-closed (disabled).
#
# MUST remain false/empty throughout architectural Phases 8 and 9. The Phase-8A
# Worker runtime REFUSES TO START if this parses truthy (1/true/yes), so an
# operator typo cannot activate yt-dlp before the Phase-9 safe-egress acceptance
# evidence is approved. Phase 10 is the only phase authorized to enable it.
YTDLP_NETWORK_ISOLATED=
