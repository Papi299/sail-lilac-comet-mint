# VideoFetch operator settings.
#
# This file is an environment CONTRACT: every value here is intentionally EMPTY.
# Never commit a real secret, account id, bucket name or hostname.
#
# The deployment has TWO separate runtimes with two separate identities:
#
#   [VERCEL]  the web/control plane. Owns user authentication, orchestration,
#             Worker request signing, and short-lived object-store GET signing.
#   [WORKER]  the long-lived standalone media runtime. Owns durable SQLite
#             state, media execution, and object-store WRITES.
#
# A variable belongs to exactly one runtime unless it is explicitly marked
# SHARED. Do not prefix any server secret with VITE_ — that would publish it to
# the browser bundle.


# ══════════════════════════════════════════════════════════════════════════════
# [VERCEL] Web / control plane
# ══════════════════════════════════════════════════════════════════════════════

# Server-only private-access secret. Minimum 32 UTF-8 bytes.
# Production (NODE_ENV=production) requires this value; if it is missing, empty,
# or too short the downloader APIs fail closed with HTTP 503 ACCESS_NOT_CONFIGURED
# instead of becoming public. Rotating it invalidates active private-access sessions.
# Generate with: openssl rand -base64 32
VIDEOFETCH_ACCESS_SECRET=

# Base URL of the deployed Worker. Vercel fails closed with WORKER_UNAVAILABLE
# when this is missing or the Worker cannot be reached; it NEVER falls back to
# running media processing locally.
WORKER_BASE_URL=

# --- [VERCEL] Cloudflare Access service token (server-only) -------------------
# Optional in code — but Cloudflare Access now fronts the Worker, so the
# accepted Production control plane sets both.
# Configure BOTH or NEITHER: exactly one of the pair makes getWorkerClient()
# fail closed with WORKER_UNAVAILABLE, without naming which half was wrong.
#
# These authenticate VERCEL to the Cloudflare Access layer that fronts the
# Worker tunnel. They are sent as the CF-Access-Client-Id / CF-Access-Client-Secret
# request headers and are INDEPENDENT of the VideoFetch HMAC credentials below:
# they are never part of the HMAC canonical request, and rotating them does not
# touch the shared Worker signing pair.
#
# These are CONFIGURED AND STORED on Vercel only. The Worker never reads them
# from its environment and never consumes, verifies, persists or intentionally
# logs them. The browser must never see them — never prefix them with VITE_.
#
# Whether Cloudflare Access strips these headers before forwarding to the
# origin has since been measured against the real ingress and accepted:
# CLOUDFLARE-ACCESS-ORIGIN-CREDENTIAL-STRIPPING-001 is CLOSED (deployment
# runbook §11). That acceptance covers the measured ingress topology only;
# changing the topology requires re-measuring it.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=

# --- [VERCEL] Object-store GET signer (server-only) ---------------------------
# Vercel's production code signs GetObject with this identity and nothing else.
# It is a SEPARATE credential from the Worker's writer identity, and the Worker
# must NEVER receive these values.
#
# Note the difference between the two boundaries. The APPLICATION boundary is
# exact: Vercel only ever signs GetObject. The PROVIDER boundary is coarser —
# R2's persistent S3 token presets are read+list or read+write+list, so the
# issued token may permit more than the application invokes. Exact per-action
# scoping needs temporary credentials. R2-CREDENTIAL-SCOPE-DECISION-001 is
# CLOSED (Option B): its per-operation temporary credentials apply to the
# Worker's WRITES, minted by the host broker below. This read-side signer is a
# separate, bucket-scoped identity (deployment runbook §5b, §11).
# Required regardless: separate identities, bucket-scoped, no bucket admin.
R2_SIGNER_ACCESS_KEY_ID=
R2_SIGNER_SECRET_ACCESS_KEY=
# Optional; only for temporary credentials.
R2_SIGNER_SESSION_TOKEN=


# ══════════════════════════════════════════════════════════════════════════════
# [WORKER] Standalone Worker runtime
# ══════════════════════════════════════════════════════════════════════════════
# Consumed exclusively by src/worker/runtime/config.server.ts. Malformed or
# missing REQUIRED values fail startup closed, before the Worker ever listens.

# --- [WORKER] Listener --------------------------------------------------------
# Internal bind only. Phase-8B deployment MUST terminate TLS in front of the
# Worker; it speaks plain HTTP and exposes no second admin/debug port.
# Defaults: 0.0.0.0 and 8080.
WORKER_BIND_HOST=
WORKER_PORT=

# --- [WORKER] Persistent state ------------------------------------------------
# REQUIRED. Absolute path to the persistent volume holding the Worker's SQLite
# database and its WAL/SHM sidecars — and nothing else. The database file name
# is derived internally; it is never configurable and never request-controlled.
# Must NOT be under /tmp. Container default: /var/lib/videofetch
WORKER_DATA_DIRECTORY=

# --- [SHARED] Worker HMAC control credentials ---------------------------------
# The SAME key id and secret are configured on BOTH Vercel (to sign) and the
# Worker (to verify). Minimum 32 UTF-8 bytes. Generate with:
#   openssl rand -base64 32
WORKER_CONTROL_KEY_ID=
WORKER_CONTROL_SECRET=

# Optional rotation slot, verified by the WORKER only. Supply BOTH or NEITHER;
# the previous key id must differ from the current one. During a rotation the
# Worker accepts both identities so in-flight Vercel requests keep working.
WORKER_CONTROL_PREVIOUS_KEY_ID=
WORKER_CONTROL_PREVIOUS_SECRET=

# --- [SHARED] Object-store location -------------------------------------------
# Location only, no credentials. Both runtimes address the same private bucket.
# R2_JURISDICTION is one of: default | eu | us  (defaults to "default").
R2_ACCOUNT_ID=
R2_BUCKET=
R2_JURISDICTION=

# --- [WORKER] Object-store access -- NO CREDENTIAL --------------------------
# WORKER-R2-TEMP-CREDENTIAL-DELEGATION-001.
#
# The media Worker holds NO persistent R2 credential. It receives a socket
# path, and asks the trusted host broker for a fresh credential per operation,
# scoped to one bucket, one exact object key, one S3 action and a bounded TTL.
#
# This is the ONLY R2 access variable the Worker reads. It is a rendezvous
# point, not a secret.
R2_BROKER_SOCKET_PATH=/run/videofetch-r2-broker/broker.sock

# The superseded persistent writer contract:
#
#   R2_WRITER_ACCESS_KEY_ID
#   R2_WRITER_SECRET_ACCESS_KEY
#   R2_WRITER_SESSION_TOKEN
#
# These must NOT be set on the Worker. They are not merely ignored — the Worker
# runtime refuses to start if any of them is present, in every deployment mode,
# because their presence means a long-lived R2 credential is sitting inside the
# media container.

# --- [BROKER ONLY] Object-store PARENT credential ---------------------------
# NEVER set these on the Worker or on Vercel. They belong exclusively to the
# trusted broker process, which runs on the VM host outside the media network
# namespace, and are supplied there through a root-owned mode-0400
# EnvironmentFile. See deploy/systemd/r2-broker.env.example.
#
# The provider-issued parent token is necessarily broader than anything it
# mints; narrowing to exactly PutObject / HeadObject / DeleteObject happens at
# mint time via R2 temporary-credential local signing, which is the only
# mechanism that can express an explicit per-action scope.
#
#   R2_BROKER_PARENT_ACCESS_KEY_ID
#   R2_BROKER_PARENT_SECRET_ACCESS_KEY


# ══════════════════════════════════════════════════════════════════════════════
# [SHARED] Media execution limits
# ══════════════════════════════════════════════════════════════════════════════
# The Worker validates these strictly and fails startup closed on a malformed
# value rather than silently falling back to a default.

NODE_ENV=development

# Delivered-media ceiling, in bytes. Unset or empty means the image default:
# 4 GiB = 4294967296 bytes. Production leaves it unset on purpose, so the
# Worker image's default is authoritative; there is no need to set it.
#
# It is a CAPACITY contract, not only a policy value: one job's original and
# produced artifact (or both split halves and the merge) coexist, so a job may
# hold 2 x this value in the media workspace, and the Worker refuses to start
# unless that filesystem has at least 2 x this value in total AND available.
# Download time (DOWNLOAD_TIMEOUT) and job lifetime (FILE_EXPIRATION_MINUTES)
# remain separate, independent bounds.
MAX_FILE_SIZE=
MAX_VIDEO_DURATION=7200
FILE_EXPIRATION_MINUTES=45
MAX_CONCURRENT_DOWNLOADS=3
MAX_CONCURRENT_PER_PRINCIPAL=2
RATE_LIMIT=20

# Ephemeral media working directory. Absolute path. MUST be distinct from
# WORKER_DATA_DIRECTORY — media is never written to the durable SQLite volume.
# Container default: /tmp/videofetch. In Production that path is an exact bind
# of the bounded 10 GiB disk workspace /srv/videofetch/media/workspace
# (deploy/systemd/srv-videofetch-media.mount), wiped before every Worker start.
TEMP_DIRECTORY=

# Absolute path to the ffmpeg binary. Container default: /usr/bin/ffmpeg
FFMPEG_PATH=

# [WORKER] Generic yt-dlp extraction: application feature state.
# (PHASE-10C1-YTDLP-RUNTIME-FOUNDATION-001; enabled in Production by
#  PHASE-10E-PERSISTENT-ON-DEMAND-GENERIC-ENABLEMENT-001)
#
# Absent means DISABLED. The only accepted values are exactly `true` and
# `false` — the retired 1/true/yes truthiness rule is gone, and any other
# spelling (`1`, `yes`, `TRUE`) is a startup failure rather than a silent
# state, so a typo can never resolve to "enabled".
#
# Generic execution IS implemented: the Worker's direct-first router hands an
# eligible public URL to the image's pinned yt-dlp runtime when this is `true`.
# The accepted Production Worker persists `true` in /etc/videofetch/worker.env
# on its VM. That value lives there, never in this template.
#
# This variable is ONLY the feature switch. It is not the safe-egress boundary
# and attests nothing about it: yt-dlp's own DNS lookups, redirects and
# subrequests are contained solely by the external media network namespace,
# its host-owned nftables policy and the watchdog.
#
# LOCAL DEVELOPMENT: leave this absent (disabled), as below. Set it to `true`
# only on a Worker that is deliberately running behind an equivalent,
# externally enforced safe-egress boundary.
YTDLP_ENABLED=
#
# RETIRED — both variables MUST be absent. The presence of either, at any
# value, is startup-fatal:
#
#   YTDLP_NETWORK_ISOLATED  An operator assertion that yt-dlp ran behind an
#                           isolated network. It was never the boundary; the
#                           media network namespace and its externally owned
#                           nftables policy are. The Worker runtime refuses to
#                           start if this is present at ANY value, `false`
#                           included, so a stale deployment fails closed.
#
#   YTDLP_PATH              Chose the yt-dlp executable and prepended arbitrary
#                           leading arguments to every invocation. The Worker's
#                           runtime identity is now a reviewed constant in the
#                           image. Also startup-fatal if present.
