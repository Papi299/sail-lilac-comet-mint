#!/bin/bash
# ACCEPTANCE TOOLING ONLY — multicast deny attribution.
# (SAFE-EGRESS-MULTICAST-ATTRIBUTION-001)
#
# ############################################################################
# #                                                                          #
# #  THIS SCRIPT IS NOT PART OF THE PRODUCTION STARTUP PATH.                 #
# #                                                                          #
# #  No systemd unit references it, nothing execs it, and it refuses to run  #
# #  without an explicit acknowledgement flag. It mutates namespace routing  #
# #  and must only ever be run by a human performing Phase-9 acceptance.     #
# #                                                                          #
# ############################################################################
#
# THE PROBLEM IT SOLVES
#
# In the prototype acceptance run, IPv4 224.0.0.0/4 and IPv6 ff00::/8 were
# unreachable because the namespace had NO ROUTE to them. The connection
# therefore failed before netfilter's output hook was ever consulted, and the
# deny-v4 / deny-v6 counters did not move. "It failed" is not evidence: a
# destination denied by absence of a route looks exactly like a destination
# denied by policy, and only one of those survives a routing change.
#
# This helper installs a MINIMAL temporary route so packets to a multicast test
# destination actually reach the enforcement point, letting the denial be
# attributed to the firewall rule by its own counter.
#
# WHAT IT DOES NOT DO
#
#   * It never touches nftables. The production policy is not weakened,
#     reloaded or reordered — the whole point is to exercise it unchanged.
#   * It never widens the deny sets. 224.0.0.0/4 and ff00::/8 stay denied; a
#     route only makes the denial REACHABLE, and therefore observable.
#   * It never leaves routes behind. Cleanup runs from an EXIT trap, so it
#     also runs on error, on a failed assertion and on Ctrl-C.
#
# Usage:
#   vf-egress-multicast-route-test --phase9-acceptance [--full-range]
#
# Exit 0 means the routes were installed, the boundary re-verified, and
# everything was removed again.

set -uo pipefail
VF_PROG=vf-egress-multicast-route-test

LIB="${VF_EGRESS_LIB:-/usr/local/lib/videofetch/vf-egress-lib.sh}"
# shellcheck source=vf-egress-lib.sh
. "$LIB"

VERIFY="${VF_EGRESS_VERIFY:-/usr/local/sbin/vf-egress-policy-verify}"
INSTALL="${VF_EGRESS_INSTALL:-/usr/local/sbin/vf-egress-policy-install}"

# Narrow single-host test destinations INSIDE the denied ranges, not the whole
# ranges. A /32 and a /128 are enough to make one packet reach the rule, and
# they perturb the namespace as little as possible.
V4_TEST="${VF_MULTICAST_V4_TEST:-224.0.2.1/32}"
V6_TEST="${VF_MULTICAST_V6_TEST:-ff0e::1/128}"

ACK=0
FULL_RANGE=0
for arg in "$@"; do
  case "$arg" in
    --phase9-acceptance) ACK=1 ;;
    --full-range) FULL_RANGE=1 ;;
    *) vf_die "unknown argument '$arg'" ;;
  esac
done

if [ "$FULL_RANGE" -eq 1 ]; then
  V4_TEST=224.0.0.0/4
  V6_TEST=ff00::/8
fi

# ── Refuse to run implicitly ───────────────────────────────────────────────
if [ "$ACK" -ne 1 ]; then
  cat >&2 <<'USAGE'
vf-egress-multicast-route-test: refusing to run.

This is Phase-9 ACCEPTANCE tooling. It temporarily mutates the media
namespace's route table and must never run as part of normal operation.

Re-run with --phase9-acceptance if that is genuinely what you are doing.
USAGE
  exit 2
fi

[ "$(id -u)" -eq 0 ] || vf_die "must run as root: routes are installed into the media namespace"

vf_config_load

# ── Refuse to run outside the expected media namespace ─────────────────────
#
# Two independent checks. The container name alone is not enough: a namespace
# that happens to carry that name but is NOT the enforced media namespace must
# not be mutated, so the presence of the production policy is required as well.
PID="$(vf_netns_pid)" || vf_die "media namespace holder '$VF_NETNS_CONTAINER' is not running"

vf_in_ns "$PID" "$VF_NFT" list table inet videofetch_egress >/dev/null 2>&1 \
  || vf_die "namespace pid=$PID carries no 'inet videofetch_egress' table.
This is not the enforced media namespace; refusing to touch its routes."

"$VERIFY" >/dev/null 2>&1 \
  || vf_die "the safe-egress boundary does not currently verify.
Refusing to add test routes to a namespace whose policy is already in an
unknown state — fix the boundary first, then measure it."

# ── Record the original route state ────────────────────────────────────────
BEFORE="$(mktemp)"
AFTER_CLEANUP="$(mktemp)"
{
  echo "### ipv4"; vf_in_ns "$PID" "$VF_IP" -4 route show 2>/dev/null
  echo "### ipv6"; vf_in_ns "$PID" "$VF_IP" -6 route show 2>/dev/null
} > "$BEFORE"

echo "$VF_PROG: recorded pre-test route state ($(grep -c . "$BEFORE") lines)"

# The egress interface is DERIVED, never hard-coded: neither the Lima-assigned
# container address, nor Docker's current bridge subnet, nor an interface name
# that could change between reboots may be baked in here.
DEV="$(vf_in_ns "$PID" "$VF_IP" -4 route show default 2>/dev/null | awk '/ dev /{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1); exit}')"
[ -n "$DEV" ] || vf_die "cannot derive the namespace's egress interface from its default route"

ADDED_V4=0
ADDED_V6=0

cleanup() {
  local rc=$?
  echo "$VF_PROG: cleaning up temporary routes"

  [ "$ADDED_V4" -eq 1 ] && vf_in_ns "$PID" "$VF_IP" -4 route del "$V4_TEST" dev "$DEV" 2>/dev/null
  [ "$ADDED_V6" -eq 1 ] && vf_in_ns "$PID" "$VF_IP" -6 route del "$V6_TEST" dev "$DEV" 2>/dev/null

  {
    echo "### ipv4"; vf_in_ns "$PID" "$VF_IP" -4 route show 2>/dev/null
    echo "### ipv6"; vf_in_ns "$PID" "$VF_IP" -6 route show 2>/dev/null
  } > "$AFTER_CLEANUP"

  if ! diff -q "$BEFORE" "$AFTER_CLEANUP" >/dev/null 2>&1; then
    echo "$VF_PROG: ERROR: the route table did NOT return to its original state." >&2
    diff "$BEFORE" "$AFTER_CLEANUP" >&2 || true
    rc=1
  else
    echo "$VF_PROG: route table restored exactly"
  fi

  # Put the route baseline back where the watchdog expects it, through the
  # trusted install path. Routes only — the nftables fingerprint is never
  # re-baselined here, so the firewall policy itself is still held to the
  # baseline taken at install time.
  "$INSTALL" --routes-baseline-only >/dev/null 2>&1 \
    || { echo "$VF_PROG: ERROR: could not restore the route baseline" >&2; rc=1; }

  "$VERIFY" >/dev/null 2>&1 \
    || { echo "$VF_PROG: ERROR: the boundary does not verify after cleanup" >&2; rc=1; }

  rm -f "$BEFORE" "$AFTER_CLEANUP"
  [ "$rc" -eq 0 ] && echo "$VF_PROG: OK - boundary verified, nothing left behind"
  exit "$rc"
}
# Installed BEFORE the first route is added, so there is no window in which a
# failure could leave a route behind.
trap cleanup EXIT INT TERM

# ── Install the minimal temporary routes ───────────────────────────────────
echo "$VF_PROG: adding temporary test route $V4_TEST dev $DEV"
if vf_in_ns "$PID" "$VF_IP" -4 route add "$V4_TEST" dev "$DEV" 2>/dev/null; then
  ADDED_V4=1
else
  echo "$VF_PROG: WARNING: could not add the IPv4 test route (already present?)" >&2
fi

echo "$VF_PROG: adding temporary test route $V6_TEST dev $DEV"
if vf_in_ns "$PID" "$VF_IP" -6 route add "$V6_TEST" dev "$DEV" 2>/dev/null; then
  ADDED_V6=1
else
  echo "$VF_PROG: WARNING: could not add the IPv6 test route (IPv6 disabled in this namespace?)" >&2
fi

[ "$ADDED_V4" -eq 1 ] || [ "$ADDED_V6" -eq 1 ] \
  || vf_die "no test route could be installed; there is nothing to attribute"

# Re-baseline ROUTES ONLY so the watchdog does not tear the Worker down in the
# middle of the measurement. This is an acceptance-time action by a root
# operator who could change these routes anyway; it grants no new authority,
# and the nftables baseline is untouched.
"$INSTALL" --routes-baseline-only >/dev/null \
  || vf_die "could not re-baseline routes for the measurement window"

# ── Report the attribution point ───────────────────────────────────────────
cat <<REPORT

$VF_PROG: temporary routes are live in netns pid=$PID.

Multicast destinations now REACH the nftables enforcement point, so a denial
can be attributed to the deny rule's own counter instead of to a missing route.

Read the counters before and after each probe, from OUTSIDE the namespace:

  nsenter -t $PID -n nft -j list chain inet videofetch_egress output

and probe from INSIDE the Worker container, e.g.

  docker exec videofetch-worker node /tmp/videofetch/probe-one.mjs 224.0.2.1 80
  docker exec videofetch-worker node /tmp/videofetch/probe-one.mjs ff0e::1 80

Expected: the probe is denied AND deny-v4 / deny-v6 increment. A denial with a
flat counter still means "no route", not "policy", and the gate stays open.

Press Enter to remove the test routes and restore the baseline.
REPORT

read -r _ || true
# The EXIT trap performs cleanup, verification and reporting.
