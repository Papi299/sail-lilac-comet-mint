#!/bin/sh
# Resolve the host's videofetch-broker GID into a non-secret deployment
# environment file (WORKER-R2-TEMP-CREDENTIAL-DELEGATION-001).
#
# WHY THIS EXISTS
#
# `docker run --group-add <name>` resolves the NAME inside the container image,
# not on the host. The Worker image defines no `videofetch-broker` group, so a
# named --group-add either fails or silently resolves to something unintended.
# The container must be given the host group's NUMERIC GID instead.
#
# The GID is allocated by the host when the group is created, so it must not be
# hard-coded to a guessed global value. It is resolved here, at install time,
# and written where systemd can expand it into ExecStart.
#
# This value is NOT a secret. It is an integer group id, and the file is
# deliberately world-readable so `systemctl show` and ordinary operators can
# inspect it.
#
# Usage:  vf-r2-broker-gid-write [group-name] [output-file]

set -eu

GROUP_NAME="${1:-videofetch-broker}"
OUTPUT="${2:-/etc/videofetch/broker-gid.env}"

GID="$(getent group "$GROUP_NAME" | cut -d: -f3)"

if [ -z "$GID" ]; then
  echo "vf-r2-broker-gid-write: group '$GROUP_NAME' does not exist on this host" >&2
  echo "create it first:  groupadd --system $GROUP_NAME" >&2
  exit 1
fi

case "$GID" in
  ''|*[!0-9]*)
    echo "vf-r2-broker-gid-write: resolved GID '$GID' is not numeric" >&2
    exit 1
    ;;
esac

mkdir -p "$(dirname "$OUTPUT")"
umask 022
cat > "$OUTPUT" <<EOF2
# Generated by vf-r2-broker-gid-write. Do not edit by hand.
# Numeric GID of the host '$GROUP_NAME' group. Not a secret.
VIDEOFETCH_BROKER_GID=$GID
EOF2

echo "vf-r2-broker-gid-write: $GROUP_NAME -> GID $GID written to $OUTPUT"
