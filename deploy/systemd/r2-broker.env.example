# Trusted R2 credential broker environment — TEMPLATE ONLY.
#
# Install as /etc/videofetch/r2-broker.env, owned by root, mode 0400.
# This file holds the ONLY copy of the persistent R2 parent credential in the
# system. It must never be readable by the Worker's user, never bind-mounted
# into the media container, and never passed on a command line.
#
# NOTHING HAS BEEN PROVISIONED. Every value below is intentionally empty; no R2
# bucket, token or account has been created for this deployment.

# Object-store location. Shared with the Worker, which receives these too.
R2_ACCOUNT_ID=
R2_BUCKET=
# One of: default | eu | us   (omit for "default")
R2_JURISDICTION=

# The PERSISTENT R2 PARENT CREDENTIAL. Broker-only.
#
# This is the identity the broker derives every short-lived, action-scoped,
# single-object credential from. It is never given to the Worker, never sent
# over the Unix socket, and never logged — a broker configuration failure names
# the offending VARIABLE and never its value.
#
# Provision it as a bucket-scoped S3 API token with object read/write on ONE
# bucket and no bucket administration. Its provider-issued permissions are
# necessarily broader than any credential it mints; narrowing to exactly
# PutObject / HeadObject / DeleteObject happens at mint time, per operation,
# through the `actions` list that only local signing can express.
R2_BROKER_PARENT_ACCESS_KEY_ID=
R2_BROKER_PARENT_SECRET_ACCESS_KEY=
