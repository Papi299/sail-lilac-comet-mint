# Designated-resolver readiness for the media namespace.
# (PRODUCTION-DNS-RESOLVER-001)
#
# Ordered in FRONT of the namespace holder so the stack cannot come up
# reporting "operational" while the resolver its own configuration names is
# absent — which is exactly what happened after Phase-9 cleanup: six active
# units, a healthy Worker, a passing verifier, and no resolver at all.
#
# This is a FUNCTIONAL gate. It is deliberately NOT part of the safe-egress
# security chain: vf-egress-policy-verify never consults it, and it never
# consults vf-egress-policy-verify. A DNS outage must not be able to report
# itself as a boundary breach, and a boundary breach must not be maskable by
# DNS being fine.
#
# Runs as root only because /etc/videofetch is 0700 (it also holds broker
# credentials), so an unprivileged user cannot read the resolver declaration.
# Every capability is dropped: emitting a DNS query needs none.

[Unit]
Description=VideoFetch designated DNS resolver readiness (media namespace)
Documentation=file:/opt/videofetch/docs/architecture/worker-deployment-runbook.md

# systemd-resolved provides the stub listener at the designated address (see
# resolved.conf.d/10-videofetch-media-dns.conf.example). docker.service owns the
# bridge that address belongs to. Ordering only: the readiness probe itself is
# the authority on whether the resolver is actually answering, so neither unit
# being "started" is taken as proof of anything.
After=systemd-resolved.service docker.service network-online.target
Wants=systemd-resolved.service network-online.target

[Service]
Type=notify
NotifyAccess=all
# Must exceed VF_DNS_WATCH_INTERVAL (15s default), which is when the probe
# loop sends its keepalive.
WatchdogSec=60

ExecStart=/usr/local/sbin/vf-media-dns-check --watch

# Fail closed, like the egress watchdog: do not silently restart into a
# half-working resolver. A stopped unit stops the Worker through BindsTo=,
# which is the intended, visible outcome.
Restart=no

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
