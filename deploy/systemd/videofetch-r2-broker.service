# VideoFetch trusted R2 credential broker
# (WORKER-R2-TEMP-CREDENTIAL-DELEGATION-001)
#
# Runs on the VM HOST, as its own unprivileged user, OUTSIDE the media network
# namespace. This unit is the single holder of the persistent R2 parent
# credential in the entire system.
#
# Nothing here has been provisioned. This file is the deployment contract; the
# referenced environment file contains no secret in this repository.

[Unit]
Description=VideoFetch trusted R2 credential broker
Documentation=file:/opt/videofetch/docs/architecture/worker-deployment-runbook.md
After=local-fs.target

# Deliberately NOT bound to the Worker unit. The broker may run while the
# Worker is down; the Worker must never run while the broker is down. That
# asymmetry is the fail-closed direction — see videofetch-worker.service.

# A malformed configuration is startup-fatal by design. Restarting forever on a
# configuration error would hide it, so give up and stay down — which makes the
# Worker stay down too.
#
# These bound the Restart=on-failure policy declared in [Service]. They are
# UNIT-level directives: systemd parses the start rate limit from [Unit], and
# ignores both keys with a warning if they appear in [Service], which silently
# removes the limit they exist to impose.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=videofetch-broker
Group=videofetch-broker

# The socket lives in a broker-owned runtime directory. 0750 lets the Worker's
# supplementary group traverse the directory; the socket inode itself is
# chmod'ed to 0660 by the broker immediately after bind, so only the broker's
# group may connect(2).
RuntimeDirectory=videofetch-r2-broker
RuntimeDirectoryMode=0750

Environment=NODE_ENV=production
Environment=R2_BROKER_SOCKET_PATH=/run/videofetch-r2-broker/broker.sock

# The PARENT R2 credential is supplied ONLY here, via a root-owned file with
# mode 0400:
#
#   R2_ACCOUNT_ID=
#   R2_BUCKET=
#   R2_JURISDICTION=
#   R2_BROKER_PARENT_ACCESS_KEY_ID=
#   R2_BROKER_PARENT_SECRET_ACCESS_KEY=
#
# It is NEVER passed on the command line: argv is world-readable through /proc,
# so a secret in ExecStart would be readable by every local account.
EnvironmentFile=/etc/videofetch/r2-broker.env

# NODE RUNTIME REQUIREMENT: Node >= 22.6.
#
# The broker runs TypeScript directly through Node's native type stripping, so
# the distribution's packaged Node is NOT necessarily sufficient — Ubuntu
# 24.04 ships Node 18, which does not support --experimental-strip-types. Point
# this at a Node 22 runtime supplied by the deployment.
#
ExecStart=/opt/videofetch/node/bin/node \
  --import /opt/videofetch/scripts/register-ts-aliases.mjs \
  --experimental-strip-types \
  /opt/videofetch/src/broker/r2/main.ts

Restart=on-failure
RestartSec=2

# The start rate limit that backs this Restart= policy is declared in [Unit],
# which is the section systemd parses it from.

# ── Hardening ──────────────────────────────────────────────────────────────
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

# MemoryDenyWriteExecute is deliberately NOT set. This is a measured decision,
# not an oversight.
#
# MEASURED on the target VM (Ubuntu 24.04.4, Node 22.23.2, aarch64), running
# this exact broker:
#
#   1. MemoryDenyWriteExecute=yes, JIT enabled
#        -> V8 fatal error in v8::base::OS::SetPermissions (errno 12)
#        -> Result=core-dump, code=dumped/status=5/TRAP. Never starts.
#
#   2. MemoryDenyWriteExecute=yes, --jitless
#        -> ERR_WEBASSEMBLY_NOT_SUPPORTED at stripTypeScriptModuleTypes:
#           "WebAssembly is not supported in this environment, but is required
#           for TypeScript". Never starts.
#
#        --jitless disables WebAssembly, and Node's native type stripper is a
#        WASM module. Since the broker runs TypeScript directly, W^X and
#        --jitless are jointly unusable here. (Confirmed by control: --jitless
#        runs plain .mjs fine under W^X, and fails only with
#        --experimental-strip-types.)
#
#   3. No MemoryDenyWriteExecute, JIT enabled, every other directive above
#        -> active, listening, stable.
#
# A unit that cannot start is not a security control, so the directive is
# omitted rather than shipped broken. Every other confinement above is retained
# and was verified active in the same run — most importantly PrivateNetwork,
# RestrictAddressFamilies=AF_UNIX and an empty CapabilityBoundingSet, which are
# what actually contain this process.
#
# To reinstate W^X, the broker would have to stop relying on runtime type
# stripping (precompiled JS), at which point --jitless becomes viable again.

# The broker performs LOCAL signing only — it derives credentials by signing a
# JWT with the parent secret and makes no API call to Cloudflare. It therefore
# needs no network whatsoever, and is denied one outright.
#
# NOTE: this is only correct while local signing is used. Switching to the
# Cloudflare Temporary Credentials API would require network access here — and
# would also lose the explicit per-action scoping that API cannot express.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
