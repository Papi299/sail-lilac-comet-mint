# VideoFetch safe-egress runtime watchdog.
# (PHASE-8B-SAFE-EGRESS-PROTOTYPE-RECOVERY-001)
#
# Recovered from the Lima prototype's vf-watchdog.service, with the dependency
# direction corrected. Nothing here has been provisioned or deployed.
#
# THE CORRECTION
#
# The prototype ordered its watchdog `After=vf-worker.service` and nothing
# depended on it, so a watchdog that died left the Worker running with no
# monitoring at all and no signal that monitoring had stopped. Here the Worker
# declares Requires/After/BindsTo on THIS unit, so the watchdog is a
# precondition for the Worker rather than an optional companion to it.
#
# The prototype also invoked a `vf-policy-breach.target` that did not exist;
# the call silently failed. No such target is reproduced. The breach path is an
# explicit unit dependency instead: this unit exits nonzero and BindsTo= stops
# the Worker. That is testable, whereas starting a nonexistent target is not.

[Unit]
Description=VideoFetch safe-egress runtime watchdog (netlink event driven, fail-closed)
Documentation=file:/opt/videofetch/docs/architecture/safe-egress.md
After=videofetch-egress-policy.service
Requires=videofetch-egress-policy.service
BindsTo=videofetch-media-netns.service videofetch-egress-policy.service

[Service]
# Type=notify so a HUNG watchdog is fatal, not merely a silent one. The main
# loop pings systemd every backstop interval; if it stops, WatchdogSec fires
# and systemd kills this unit, which stops the Worker through BindsTo=.
#
# NotifyAccess=all because the notification is sent by systemd-notify, a
# separate process from the main shell.
Type=notify
NotifyAccess=all
WatchdogSec=30

ExecStart=/usr/local/sbin/vf-egress-watchdog

# DELIBERATELY NOT RESTARTED.
#
# A breach means the boundary was found invalid. Restarting would re-verify,
# fail again and loop — or, worse, succeed against a boundary someone was
# midway through changing, and quietly re-arm. Recovery is an explicit operator
# action through these units, so a breach stays visible.
#
# The Worker cannot come back on its own either: its ExecStartPre runs the same
# verifier, and the verifier is what stays failing.
Restart=no

# ── Hardening ──────────────────────────────────────────────────────────────
#
# This unit needs root and CAP_SYS_ADMIN/CAP_SYS_PTRACE to enter another
# namespace with nsenter, so it cannot be confined as tightly as the broker.
# Everything that does not conflict with that is still applied.
NoNewPrivileges=yes
ProtectHome=yes
ProtectClock=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
